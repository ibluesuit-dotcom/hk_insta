{
  "name": "newsroom-card-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "dev:mock": "MOCK_AI=1 MOCK_DELAY=800 DATA_DIR=data/mock PORT=4311 tsx server/index.ts",
    "format": "prettier --write src server shared tests *.ts *.json"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "jsdom": "^26.1.0",
    "mammoth": "^1.9.1",
    "multer": "^2.0.2",
    "openai": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/yauzl": "^3.4.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
